config BR2_PACKAGE_PAPERJAM
	bool "paperjam"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_PILLOW
	select BR2_PACKAGE_PYTHON_PYYAML
	select BR2_PACKAGE_PYTHON_MUTAGEN
	select BR2_PACKAGE_PYTHON_DBUS
	select BR2_PACKAGE_PYTHON_EVDEV
	select BR2_PACKAGE_PYTHON_LIBGPIOD
	select BR2_PACKAGE_VLC
	select BR2_PACKAGE_WAVESHARE_EPD
	help
	  PaperJam - E-ink music player application for Raspberry Pi.

	  Features:
	  - Music library browsing (Artist/Album/Track)
	  - VLC-based audio playback
	  - Bluetooth audio output
	  - Waveshare e-Paper display support
	  - PiSugar 3 battery monitoring

	  https://github.com/your-repo/paperjam
