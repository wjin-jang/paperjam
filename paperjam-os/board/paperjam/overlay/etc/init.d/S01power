#!/bin/sh
# PaperJam OS - Power Management Init Script
# S01power - Early power optimizations

DAEMON="power"

start() {
    printf "Setting up power management: "

    # Disable HDMI (saves ~25mA)
    if [ -x /opt/vc/bin/tvservice ]; then
        /opt/vc/bin/tvservice -o 2>/dev/null || true
    fi

    # Set CPU governor to powersave initially
    if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        echo powersave > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
        # Apply to all CPU cores
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -f "$cpu" ] && echo powersave > "$cpu"
        done
    fi

    # Set dirty page writeback to 60 seconds (reduce SD card writes)
    echo 6000 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || true
    echo 6000 > /proc/sys/vm/dirty_expire_centisecs 2>/dev/null || true

    # Increase dirty ratio for fewer write operations
    echo 20 > /proc/sys/vm/dirty_ratio 2>/dev/null || true
    echo 10 > /proc/sys/vm/dirty_background_ratio 2>/dev/null || true

    # Disable kernel watchdog
    echo 0 > /proc/sys/kernel/watchdog 2>/dev/null || true
    echo 0 > /proc/sys/kernel/nmi_watchdog 2>/dev/null || true

    # Set swappiness to minimum (we have limited RAM)
    echo 10 > /proc/sys/vm/swappiness 2>/dev/null || true

    # Disable USB autosuspend for stability
    for usb in /sys/bus/usb/devices/*/power/autosuspend; do
        [ -f "$usb" ] && echo -1 > "$usb" 2>/dev/null || true
    done

    printf "OK\n"
}

stop() {
    printf "Stopping power management: "
    # No action needed
    printf "OK\n"
}

restart() {
    stop
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
