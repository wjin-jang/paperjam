#!/bin/sh
# PaperJam OS - PulseAudio Sound Server
# S30pulseaudio - Runs as system-wide daemon

DAEMON="/usr/bin/pulseaudio"
PIDFILE="/var/run/pulse/pid"
USER="pulse"

start() {
    printf "Starting PulseAudio: "

    # Create runtime directory
    mkdir -p /var/run/pulse
    chown pulse:pulse /var/run/pulse

    # Create state directory
    mkdir -p /var/lib/pulse
    chown pulse:pulse /var/lib/pulse

    # Start PulseAudio in system mode
    start-stop-daemon -S -q -b \
        -m -p "$PIDFILE" \
        -x "$DAEMON" -- \
        --system \
        --disallow-exit \
        --disallow-module-loading \
        --log-target=syslog
    status=$?

    if [ "$status" -eq 0 ]; then
        # Wait for socket to be ready
        sleep 1
        printf "OK\n"
    else
        printf "FAIL\n"
    fi
    return $status
}

stop() {
    printf "Stopping PulseAudio: "
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    printf "OK\n"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
