#!/bin/sh
# PaperJam OS - D-Bus Message Bus
# S20dbus - Required for Bluetooth and PulseAudio

DAEMON="/usr/bin/dbus-daemon"
PIDFILE="/var/run/dbus/pid"

start() {
    printf "Starting D-Bus: "

    # Create necessary directories
    mkdir -p /var/run/dbus

    # Generate machine-id if missing
    if [ ! -f /etc/machine-id ]; then
        dbus-uuidgen > /etc/machine-id
    fi
    if [ ! -f /var/lib/dbus/machine-id ]; then
        mkdir -p /var/lib/dbus
        cp /etc/machine-id /var/lib/dbus/machine-id
    fi

    # Start system bus
    start-stop-daemon -S -q -p "$PIDFILE" -x "$DAEMON" -- --system
    status=$?

    if [ "$status" -eq 0 ]; then
        printf "OK\n"
    else
        printf "FAIL\n"
    fi
    return $status
}

stop() {
    printf "Stopping D-Bus: "
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    printf "OK\n"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
