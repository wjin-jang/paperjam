#!/bin/sh
# PaperJam OS - Bluetooth Service
# S35bluetooth - BlueZ daemon for audio output

DAEMON="/usr/libexec/bluetooth/bluetoothd"
PIDFILE="/var/run/bluetoothd.pid"

start() {
    printf "Starting Bluetooth: "

    # Load Bluetooth kernel modules
    modprobe hci_uart 2>/dev/null || true
    modprobe btbcm 2>/dev/null || true

    # Initialize BCM Bluetooth on Pi Zero 2 W
    if [ -f /usr/bin/btattach ]; then
        /usr/bin/btattach -B /dev/ttyAMA0 -P bcm -S 3000000 &
        sleep 1
    fi

    # Start BlueZ daemon
    start-stop-daemon -S -q -b \
        -m -p "$PIDFILE" \
        -x "$DAEMON" -- \
        --noplugin=sap
    status=$?

    if [ "$status" -eq 0 ]; then
        # Wait for adapter to be ready
        sleep 2

        # Make adapter discoverable and pairable (optional)
        if command -v bluetoothctl >/dev/null 2>&1; then
            bluetoothctl power on 2>/dev/null || true
            bluetoothctl agent on 2>/dev/null || true
        fi

        printf "OK\n"
    else
        printf "FAIL\n"
    fi
    return $status
}

stop() {
    printf "Stopping Bluetooth: "

    # Power off adapter
    if command -v bluetoothctl >/dev/null 2>&1; then
        bluetoothctl power off 2>/dev/null || true
    fi

    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"

    # Kill btattach if running
    killall btattach 2>/dev/null || true

    printf "OK\n"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
