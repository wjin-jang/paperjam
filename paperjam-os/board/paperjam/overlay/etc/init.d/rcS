#!/bin/sh
# PaperJam OS - Main init script
# Runs all S* scripts in /etc/init.d

# Source common functions if available
[ -r /etc/init.d/functions ] && . /etc/init.d/functions

# Run all init scripts in order
for script in /etc/init.d/S??*; do
    [ -x "$script" ] || continue

    # Extract script name for logging
    name=$(basename "$script")

    case "$script" in
        *.sh)
            # Source shell scripts
            . "$script"
            ;;
        *)
            # Run executables
            "$script" start
            ;;
    esac
done
