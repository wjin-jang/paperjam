#!/bin/sh
# PaperJam OS - mdev device manager
# S10mdev - Dynamic device node creation

DAEMON="mdev"

start() {
    printf "Starting mdev: "

    # Mount devpts if not mounted
    if ! mountpoint -q /dev/pts; then
        mkdir -p /dev/pts
        mount -t devpts devpts /dev/pts
    fi

    # Mount shared memory
    if ! mountpoint -q /dev/shm; then
        mkdir -p /dev/shm
        mount -t tmpfs tmpfs /dev/shm
    fi

    # Start mdev for hotplug
    echo /sbin/mdev > /proc/sys/kernel/hotplug
    mdev -s

    printf "OK\n"
}

stop() {
    printf "Stopping mdev: "
    echo "" > /proc/sys/kernel/hotplug 2>/dev/null || true
    printf "OK\n"
}

restart() {
    stop
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
