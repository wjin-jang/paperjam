# PaperJam OS - PulseAudio Configuration
# /etc/pulse/default.pa

# Load ALSA modules
.ifexists module-alsa-sink.so
load-module module-alsa-sink device=hw:0
.endif

.ifexists module-alsa-source.so
# Disable microphone input (not needed)
# load-module module-alsa-source device=hw:0
.endif

# Load udev detection for audio devices
.ifexists module-udev-detect.so
load-module module-udev-detect
.else
load-module module-detect
.endif

# Bluetooth audio support
.ifexists module-bluetooth-policy.so
load-module module-bluetooth-policy
.endif

.ifexists module-bluetooth-discover.so
load-module module-bluetooth-discover
.endif

# Native protocol (for local connections)
load-module module-native-protocol-unix auth-anonymous=1

# D-Bus interface
.ifexists module-dbus-protocol.so
load-module module-dbus-protocol
.endif

# Always keep a sink loaded (prevents errors when no audio device)
load-module module-always-sink

# Automatic gain control (disabled for music playback)
# load-module module-echo-cancel

# Rescue streams to default sink/source
load-module module-rescue-streams

# Automatically switch to newly connected devices
load-module module-switch-on-connect

# Default sink (Bluetooth A2DP when available, otherwise ALSA)
set-default-sink alsa_output.hw_0

# Cork music on phone calls (if phone connected via Bluetooth)
.ifexists module-role-cork.so
load-module module-role-cork
.endif
