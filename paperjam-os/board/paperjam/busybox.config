# BusyBox Configuration for PaperJam OS
# Minimal configuration with essential utilities

CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_NO_USR=y

# Init System
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y

# Shell
CONFIG_ASH=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_HELP=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y

# Core Utilities
CONFIG_CAT=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CP=y
CONFIG_DATE=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_DIRNAME=y
CONFIG_DU=y
CONFIG_ECHO=y
CONFIG_ENV=y
CONFIG_FALSE=y
CONFIG_HEAD=y
CONFIG_HOSTNAME=y
CONFIG_ID=y
CONFIG_KILL=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MD5SUM=y
CONFIG_MKDIR=y
CONFIG_MKNOD=y
CONFIG_MKTEMP=y
CONFIG_MV=y
CONFIG_NICE=y
CONFIG_PRINTF=y
CONFIG_PS=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SED=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_SYNC=y
CONFIG_TAIL=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_TRUE=y
CONFIG_UNAME=y
CONFIG_WC=y
CONFIG_WHO=y
CONFIG_WHOAMI=y
CONFIG_XARGS=y
CONFIG_YES=y

# File System
CONFIG_BLKID=y
CONFIG_FDISK=y
CONFIG_FINDFS=y
CONFIG_FSCK=y
CONFIG_LOSETUP=y
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_VFAT=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y

# Process Utilities
CONFIG_FREE=y
CONFIG_FUSER=y
CONFIG_KILLALL=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_TOP=y
CONFIG_UPTIME=y

# Networking
CONFIG_HOSTNAME=y
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_PING=y
CONFIG_ROUTE=y
CONFIG_WGET=y

# Daemon Utilities
CONFIG_START_STOP_DAEMON=y
CONFIG_FEATURE_START_STOP_DAEMON_LONG_OPTIONS=y

# System
CONFIG_DMESG=y
CONFIG_HWCLOCK=y
CONFIG_LOGGER=y
CONFIG_SYSLOGD=y
CONFIG_KLOGD=y

# User Management
CONFIG_ADDUSER=y
CONFIG_ADDGROUP=y
CONFIG_DELUSER=y
CONFIG_DELGROUP=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_PASSWD=y
CONFIG_SU=y

# Editors
CONFIG_VI=y

# Misc
CONFIG_CLEAR=y
CONFIG_LESS=y
CONFIG_WATCHDOG=y
